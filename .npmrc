# better-sqlite3 প্যাকেজটি প্রতিটি প্ল্যাটফর্মের prebuilt বাইনারি (prebuilds/) নিয়েই
# npm থেকে নামে — তাই এটির জন্য কম্পাইল করার প্রয়োজন নেই।
# কিন্তু npm প্যাকেজে binding.gyp ফাইল দেখলে নিজে থেকেই `node-gyp rebuild` চালাতে
# চায়, যার জন্য Python + C++ build tools দরকার। সেগুলো না থাকলে `npm install`
# ব্যর্থ হয়ে node_modules খালি রেখে দেয়।
#
# install script বন্ধ রাখলে npm সরাসরি prebuilt বাইনারিটাই ব্যবহার করে, তাই
# Windows/macOS/Linux যেকোনো মেশিনে `npm install` সোজা কাজ করে।
#
# ⚠️ ভবিষ্যতে এমন কোনো প্যাকেজ যোগ করলে যেটির সত্যিই install/postinstall script
# দরকার (যেমন sharp, puppeteer), তখন এই ফাইলটি মুছে দিন বা
# `npm install --ignore-scripts=false` চালান।
ignore-scripts=true

# ---------------------------------------------------------------------------
# বাজার দর — প্রয়োজনীয় environment variables
# এই ফাইলটি `.env.local` নামে কপি করে মানগুলো বসান।
# ---------------------------------------------------------------------------

# BetterAuth-এর সেশন সাইন করার গোপন চাবি (অবশ্যই বদলাবেন)।
# তৈরি করতে: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# ডিপ্লয় করার পর সাইটের পুরো ঠিকানা (লোকালে দরকার নেই)।
# BETTER_AUTH_URL=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# ডেটাবেজ
# ---------------------------------------------------------------------------
# খালি রাখলে লোকাল SQLite ফাইল (bazardor.sqlite) ব্যবহার হবে — কিছু সেটআপ লাগে না।
# Vercel/Netlify-তে ডিপ্লয় করলে Postgres ডেটাবেজের URL দিন (যেমন Neon/Supabase)।
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# সোশ্যাল লগইন (ঐচ্ছিক — না দিলে বাটন শুধু দেখাবে, কাজ করবে না)
# ---------------------------------------------------------------------------
# Google: https://console.cloud.google.com/apis/credentials
# Google Cloud Console → Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers → New OAuth App
# Authorization callback URL:
#   http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
